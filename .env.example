# Domain and Host Configuration
# Change this to your server's fully qualified domain name (e.g. n8n.example.com)
DOMAIN_NAME=n8n.example.com
PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
TIMEZONE=UTC

# Discord Bot Token (from Discord Developer Portal)
# Only required if you are using the Discord channel
DISCORD_BOT_TOKEN=your_discord_bot_token_here
